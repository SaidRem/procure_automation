# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# По умолчанию broker и backend собираются из REDIS_*; переопределять не обязательно.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Ссылки в письмах и время жизни токенов
FRONTEND_URL=http://localhost:8000
PASSWORD_RESET_TIMEOUT=86400

# Email
# Для разработки используется console backend, SMTP-переменные можно не заполнять.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Накладная по оформленному заказу; по умолчанию — DEFAULT_FROM_EMAIL.
ORDER_ADMIN_EMAIL=
